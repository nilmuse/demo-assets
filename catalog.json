{
  "$schema": "./catalog.schema.json",
  "version": "1.1.2",
  "repository": "nilmuse/demo-assets",
  "baseUrl": "https://cdn.jsdelivr.net/gh/nilmuse/demo-assets@v1.1.2",
  "packages": {
    "marquee-content": {
      "pegasus.svg": { "description": "Pegasus image for marquee-content demo" },
      "presto.svg": { "description": "Presto image for marquee-content demo" },
      "tempo.svg": { "description": "Tempo image for marquee-content demo" },
      "vomero.svg": { "description": "Vomero image for marquee-content demo" }
    },
    "cascading-reel": {
      "reel.svg": {
        "description": "Sprite sheet for cascading-reel demo"
      }
    },
    "reel-deal": {
      "reel.svg": {
        "description": "Sprite sheet for reel-deal demo"
      }
    },
    "scratch-reveal": {
      "background.svg": {
        "description": "Background under the scratch mask"
      },
      "brush.png": {
        "description": "Brush texture for scratch-reveal demo"
      },
      "mask.webp": {
        "description": "Mask image for scratch-reveal demo"
      }
    },
    "smoke-layer": {
      "fog-texture.png": {
        "description": "Fog particle texture for smoke-layer demo"
      }
    },
    "zero-hour": {
      "digits.svg": {
        "description": "SVG sprite for countdown digits"
      },
      "separator.svg": {
        "description": "Colon separator for zero-hour timer"
      }
    },
    "iconly": {
      "sprite.svg": {
        "description": "Icon sprite for iconly demo"
      }
    },
    "clicktone": {
      "cartoon": {
        "description": "Demo sound for format-fallback testing (CodePen, README)",
        "dir": "audio",
        "formats": ["mp3", "opus", "wav", "flac", "m4a"]
      }
    }
  }
}
